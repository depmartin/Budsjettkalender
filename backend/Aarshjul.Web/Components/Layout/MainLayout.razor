@inherits LayoutComponentBase
@inject IWebHostEnvironment Env

@if (ErDemo)
{
    <div class="demobanner">Demo-modus — lokal kjøring uten Entra/Azure SQL. <a href="/demo">Bytt persona</a></div>
}

<header class="topplinje">
    <div class="topplinje-inner">
        <a class="merkenavn" href="/">Årshjul for budsjettfrister</a>
        <nav class="hovednav">
            <NavLink href="/kalender" Match="NavLinkMatch.All">Kalender</NavLink>
            <NavLink href="/aarshjul">Årshjul</NavLink>
            @* Forslag/varsler er bidragsyterens; administrator redigerer direkte (endring #1). *@
            <AuthorizeView Policy="@Autorisasjon.ErBidragsyter">
                <NavLink href="/forslag/mine">Mine forslag</NavLink>
                <VarselTeller />
            </AuthorizeView>
            <AuthorizeView Policy="@Autorisasjon.ErAdministrator">
                <NavLink href="/admin/ko">Kø</NavLink>
                <NavLink href="/admin/last-opp">Last opp</NavLink>
                <NavLink href="/admin/frister">Frister</NavLink>
                <NavLink href="/admin/generer">Generér</NavLink>
                <NavLink href="/admin/mal">Årsmal</NavLink>
                <NavLink href="/admin/innsyn">Innsyn</NavLink>
                <NavLink href="/admin/eksport">Eksporter</NavLink>
                <NavLink href="/admin/abonnement">Del kalender</NavLink>
                <NavLink href="/admin/data">Data</NavLink>
            </AuthorizeView>
            @* Internkalender: SBR-intern arbeidsliste, kun for SBR (= administrator i v1). *@
            <AuthorizeView Policy="@Autorisasjon.ErSbr">
                <NavLink href="/internkalender">Internkalender</NavLink>
            </AuthorizeView>
        </nav>
        <div class="bruker">
            <AuthorizeView>
                <Authorized>
                    <span class="avatar" title="@context.User.Identity?.Name">@Initialer(context.User.Identity?.Name)</span>
                    <a href="@LoggUtUrl" title="Logg ut">Logg ut</a>
                </Authorized>
                <NotAuthorized>
                    <a href="@LoggInnUrl">Logg inn</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</header>

<main class="side innhold">
    @Body
</main>

@code {
    private bool ErDemo => Env.IsEnvironment("Demo");
    private string LoggInnUrl => ErDemo ? "/demo" : "MicrosoftIdentity/Account/SignIn";
    private string LoggUtUrl => ErDemo ? "/demo/logg-ut" : "MicrosoftIdentity/Account/SignOut";

    /// <summary>Initialer fra de to første ordene i navnet (til avatar-boblen). Fullt navn vises som tooltip.</summary>
    private static string Initialer(string? navn)
    {
        if (string.IsNullOrWhiteSpace(navn))
        {
            return "?";
        }
        var ord = navn.Split([' ', '-'], StringSplitOptions.RemoveEmptyEntries)
            .Where(o => char.IsLetter(o[0]))
            .Take(2)
            .Select(o => char.ToUpperInvariant(o[0]));
        var res = string.Concat(ord);
        return res.Length == 0 ? "?" : res;
    }
}

<div id="blazor-error-ui" data-nosnippet>
    En uventet feil oppstod.
    <a href="." class="reload">Last på nytt</a>
    <span class="dismiss">🗙</span>
</div>
