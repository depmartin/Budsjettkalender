@page "/aarshjul"
@using System.Globalization
@using System.Text
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@attribute [Authorize]
@inherits Visningsside
@inject ProtectedLocalStorage LokalLager

<PageTitle>Årshjul</PageTitle>

<div class="admintopp">
    <h1>Årshjul</h1>
    <div class="bryter" role="group" aria-label="Velg fremstilling">
        <button class="bryter-valg @(_visHjul ? "aktiv" : "")" @onclick="() => SettVisning(true)">Hjul</button>
        <button class="bryter-valg @(!_visHjul ? "aktiv" : "")" @onclick="() => SettVisning(false)">Tidslinje</button>
    </div>
</div>

<Ingress Nokkel="aarshjul.ingress"
         Standard="Ett budsjettløp i sin helhet, kronologisk gjennom syklusen. Fargen viser budsjettår; hold musen over et punkt for detaljer." />

<Filterpanel TilgjengeligeAar="TilgjengeligeAar" />

@if (!Lastet)
{
    <p class="melding">Laster …</p>
}
else if (Lastefeil is not null)
{
    <div class="feil">@Lastefeil</div>
}
else if (Frister.Count == 0)
{
    <p class="melding">Ingen frister i utvalget ditt.</p>
}
else
{
    var aar = Frister.Select(f => f.Budsjettaar).Distinct().OrderBy(a => a).ToList();
    var figur = _visHjul ? BeregnHjul(aar) : BeregnLineaer(aar);

    <div class="hjulfigur">
        <div class="hjulwrap" style="max-width:@(_visHjul ? "560" : "960")px">
            <svg viewBox="0 0 @F(figur.W) @F(figur.H)" role="img"
                 aria-label="Årshjul med frister fordelt gjennom året" class="aarshjul-svg">
                @figur.Skjelett
                @foreach (var p in figur.Punkter)
                {
                    var uthevet = _hoverId == p.Id;
                    <circle cx="@F(p.X)" cy="@F(p.Y)" r="@(uthevet ? "10" : "7")"
                            fill="@p.Farge" stroke="@(uthevet ? "#181c62" : "#fff")" stroke-width="@(uthevet ? "3" : "2")"
                            class="hjul-punkt" @onmouseover="() => _hoverId = p.Id" @onmouseout="() => _hoverId = null" />
                }
            </svg>

            @if (_hoverId is { } id && figur.Punkter.FirstOrDefault(x => x.Id == id) is { } valgt)
            {
                <div class="hjulboks" style="left:@F(valgt.X / figur.W * 100)%; top:@F(valgt.Y / figur.H * 100)%">
                    <div class="hjulboks-dato">@Visningformat.FormatDato(valgt.Frist)</div>
                    <div class="hjulboks-tittel">@valgt.Frist.Tittel</div>
                    <div class="hjulboks-merker">
                        <span class="merke merke-aar">Budsjettår @valgt.Frist.Budsjettaar</span>
                        <span class="merke merke-kategori">@Visningformat.KategoriNavn(valgt.Frist.Kategori)</span>
                        @if (valgt.Frist.ErTentativ)
                        {
                            <span class="merke merke-tentativ">tentativ</span>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="hjullegende">
            @foreach (var a in aar)
            {
                <span class="hjullegende-post"><span class="aarprikk" style="background:@Visningformat.FargeForAar(a)"></span>Budsjettår @a</span>
            }
        </div>
    </div>

    <h2>Detaljer</h2>
    @foreach (var løp in Frister.GroupBy(f => f.Budsjettaar).OrderBy(g => g.Key))
    {
        <section class="hjul @Visningformat.FargeklasseForAar(løp.Key)">
            <h2>Budsjettår @løp.Key</h2>
            <ol class="hjul-spor">
                @foreach (var frist in løp.OrderBy(f => f.Sorteringsdag))
                {
                    <li class="@(_hoverId == frist.Id ? "uthevet" : "")"
                        @onmouseover="() => _hoverId = frist.Id" @onmouseout="() => _hoverId = null">
                        <span class="hjul-dato">@Visningformat.FormatDato(frist)</span>
                        <span class="hjul-tittel">@frist.Tittel</span>
                        <span class="merke merke-kategori">@Visningformat.KategoriNavn(frist.Kategori)</span>
                        @if (frist.ErTentativ)
                        {
                            <span class="merke merke-tentativ">tentativ</span>
                        }
                    </li>
                }
            </ol>
        </section>
    }
}

@code {
    private const string LagerNokkel = "aarshjul-visning";
    private bool _visHjul = true;
    private Guid? _hoverId;

    /// <summary>Leser sist valgte visning (hjul/tidslinje) fra nettleseren etter første render.</summary>
    protected override async Task OnAfterRenderAsync(bool førsteRender)
    {
        if (!førsteRender)
        {
            return;
        }
        try
        {
            var lagret = await LokalLager.GetAsync<string>(LagerNokkel);
            if (lagret is { Success: true, Value: "tidslinje" } && _visHjul)
            {
                _visHjul = false;
                StateHasChanged();
            }
        }
        catch
        {
            // Utilgjengelig under prerender / uten JS — behold standard (hjul).
        }
    }

    private async Task SettVisning(bool hjul)
    {
        _visHjul = hjul;
        try
        {
            await LokalLager.SetAsync(LagerNokkel, hjul ? "hjul" : "tidslinje");
        }
        catch
        {
            // Kan ikke lagre nå — velg-tilstanden virker uansett for denne økten.
        }
    }

    private sealed record Punktdata(Guid Id, double X, double Y, string Farge, FristDto Frist);
    private sealed record Figur(double W, double H, MarkupString Skjelett, List<Punktdata> Punkter);

    private static readonly string[] Maanedskort =
        ["Jan", "Feb", "Mar", "Apr", "Mai", "Jun", "Jul", "Aug", "Sep", "Okt", "Nov", "Des"];

    // ---------------------------------------------------------------- Hjul (radiell)
    private const double HjulD = 620, HjulSenter = 310, RYtre = 278, RInnerste = 95, RMaanedstekst = 296, RRingInner = 128, RRingYtre = 262;

    private Figur BeregnHjul(List<int> aar)
    {
        var sb = new StringBuilder();
        for (var m = 1; m <= 12; m++)
        {
            var (lx1, ly1) = HjulPunkt(RInnerste, GradForMaanedstart(m));
            var (lx2, ly2) = HjulPunkt(RYtre, GradForMaanedstart(m));
            sb.Append($"<line x1=\"{F(lx1)}\" y1=\"{F(ly1)}\" x2=\"{F(lx2)}\" y2=\"{F(ly2)}\" class=\"hjul-sektor\" />");
            var (mx, my) = HjulPunkt(RMaanedstekst, GradForDag(m, 15));
            sb.Append($"<text x=\"{F(mx)}\" y=\"{F(my)}\" class=\"hjul-maaned\" text-anchor=\"middle\" dominant-baseline=\"middle\">{Maanedskort[m - 1]}</text>");
        }
        sb.Append($"<circle cx=\"{F(HjulSenter)}\" cy=\"{F(HjulSenter)}\" r=\"{F(RYtre)}\" class=\"hjul-ramme\" />");
        sb.Append($"<circle cx=\"{F(HjulSenter)}\" cy=\"{F(HjulSenter)}\" r=\"{F(RInnerste)}\" class=\"hjul-ramme\" />");
        for (var i = 0; i < aar.Count; i++)
        {
            var r = RadiusForIndeks(i, aar.Count);
            sb.Append($"<circle cx=\"{F(HjulSenter)}\" cy=\"{F(HjulSenter)}\" r=\"{F(r)}\" fill=\"none\" stroke=\"{Visningformat.FargeForAar(aar[i])}\" stroke-opacity=\"0.28\" stroke-width=\"2\" />");
        }
        sb.Append($"<text x=\"{F(HjulSenter)}\" y=\"{F(HjulSenter)}\" class=\"hjul-senter\" text-anchor=\"middle\" dominant-baseline=\"middle\">Årshjul</text>");

        var punkter = Frister.Select(f =>
        {
            var r = RadiusForIndeks(aar.IndexOf(f.Budsjettaar), aar.Count);
            var (px, py) = HjulPunkt(r, GradForDato(f.Sorteringsdag));
            return new Punktdata(f.Id, px, py, Visningformat.FargeForAar(f.Budsjettaar), f);
        }).ToList();

        return new Figur(HjulD, HjulD, new MarkupString(sb.ToString()), punkter);
    }

    private static double RadiusForIndeks(int i, int antall)
    {
        if (i < 0) i = 0;
        return antall <= 1 ? (RRingInner + RRingYtre) / 2 : RRingInner + (RRingYtre - RRingInner) * i / (antall - 1);
    }

    private static (double X, double Y) HjulPunkt(double radius, double grader)
    {
        var rad = grader * Math.PI / 180.0;
        return (HjulSenter + radius * Math.Cos(rad), HjulSenter + radius * Math.Sin(rad));
    }

    private static double GradForDato(DateOnly d) => Frac(d) * 360 - 90;
    private static double GradForMaanedstart(int m) => GradForDato(new DateOnly(2027, m, 1));
    private static double GradForDag(int m, int dag) => GradForDato(new DateOnly(2027, m, dag));

    // ---------------------------------------------------------------- Lineær tidslinje
    private const double LinW = 960, LinVenstre = 70, LinHoyre = 28, LinTopp = 46, LinLane = 60, LinBunn = 24;

    private Figur BeregnLineaer(List<int> aar)
    {
        var h = LinTopp + aar.Count * LinLane + LinBunn;
        var sb = new StringBuilder();

        // Månedsrutenett + labels øverst.
        for (var m = 1; m <= 12; m++)
        {
            var x = LinX(Frac(new DateOnly(2027, m, 1)));
            sb.Append($"<line x1=\"{F(x)}\" y1=\"{F(LinTopp - 8)}\" x2=\"{F(x)}\" y2=\"{F(h - LinBunn)}\" class=\"hjul-sektor\" />");
            var xl = LinX(Frac(new DateOnly(2027, m, 15)));
            sb.Append($"<text x=\"{F(xl)}\" y=\"22\" class=\"hjul-maaned\" text-anchor=\"middle\">{Maanedskort[m - 1]}</text>");
        }

        // Én vannrett stripe per budsjettår med årsetikett til venstre.
        for (var i = 0; i < aar.Count; i++)
        {
            var y = LinLaneY(i);
            sb.Append($"<line x1=\"{F(LinX(0))}\" y1=\"{F(y)}\" x2=\"{F(LinX(1))}\" y2=\"{F(y)}\" stroke=\"{Visningformat.FargeForAar(aar[i])}\" stroke-opacity=\"0.5\" stroke-width=\"2\" />");
            sb.Append($"<text x=\"6\" y=\"{F(y - 8)}\" class=\"hjul-aarlabel\" fill=\"{Visningformat.FargeForAar(aar[i])}\">{aar[i]}</text>");
        }

        var punkter = Frister.Select(f =>
            new Punktdata(f.Id, LinX(Frac(f.Sorteringsdag)), LinLaneY(aar.IndexOf(f.Budsjettaar)),
                Visningformat.FargeForAar(f.Budsjettaar), f)).ToList();

        return new Figur(LinW, h, new MarkupString(sb.ToString()), punkter);
    }

    private static double LinX(double frac) => LinVenstre + frac * (LinW - LinVenstre - LinHoyre);
    private static double LinLaneY(int i) => LinTopp + (i < 0 ? 0 : i) * LinLane + LinLane / 2;

    // ---------------------------------------------------------------- Felles
    private static double Frac(DateOnly d)
    {
        var start = new DateOnly(d.Year, 1, 1);
        var lengde = (new DateOnly(d.Year, 12, 31).DayNumber - start.DayNumber) + 1;
        return (d.DayNumber - start.DayNumber) / (double)lengde;
    }

    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    protected override Task<IReadOnlyList<FristDto>> HentAsync(ISynlighetskontekst ctx)
        => Lesing.HentSynligeAsync(ctx, Tilstand.TilFilter());
}
