@page "/aarshjul"
@using System.Globalization
@using System.Text
@attribute [Authorize]
@inherits Visningsside

<PageTitle>Årshjul</PageTitle>

<h1>Årshjul</h1>
<p class="ingress">Ett budsjettløp i sin helhet, som en syklus gjennom året. Hver farget ring er ett budsjettår; hvert punkt er en frist plassert på datoen sin (hold over for detaljer).</p>

<Filterpanel TilgjengeligeAar="TilgjengeligeAar" />

@if (!Lastet)
{
    <p class="melding">Laster …</p>
}
else if (Lastefeil is not null)
{
    <div class="feil">@Lastefeil</div>
}
else if (Frister.Count == 0)
{
    <p class="melding">Ingen frister i utvalget ditt.</p>
}
else
{
    var aar = Frister.Select(f => f.Budsjettaar).Distinct().OrderBy(a => a).ToList();

    <div class="hjulfigur">
        <svg viewBox="0 0 @Diagram @Diagram" role="img" aria-label="Årshjul med frister fordelt gjennom året" class="aarshjul-svg">
            @((MarkupString)ByggHjul(aar))
        </svg>

        <div class="hjullegende">
            @foreach (var a in aar)
            {
                <span class="hjullegende-post"><span class="aarprikk" style="background:@Visningformat.FargeForAar(a)"></span>Budsjettår @a</span>
            }
        </div>
    </div>

    <h2>Detaljer</h2>
    @foreach (var løp in Frister.GroupBy(f => f.Budsjettaar).OrderBy(g => g.Key))
    {
        <section class="hjul @Visningformat.FargeklasseForAar(løp.Key)">
            <h2>Budsjettår @løp.Key</h2>
            <ol class="hjul-spor">
                @foreach (var frist in løp.OrderBy(f => f.Sorteringsdag))
                {
                    <li>
                        <span class="hjul-dato">@Visningformat.FormatDato(frist)</span>
                        <span class="hjul-tittel">@frist.Tittel</span>
                        <span class="merke merke-kategori">@Visningformat.KategoriNavn(frist.Kategori)</span>
                        @if (frist.ErTentativ)
                        {
                            <span class="merke merke-tentativ">tentativ</span>
                        }
                    </li>
                }
            </ol>
        </section>
    }
}

@code {
    // --- Geometri for hjulet (SVG-koordinater) ---
    private const double Diagram = 620;
    private const double Senter = 310;
    private const double RYtre = 278;         // ytre ringkant
    private const double RInnerste = 95;      // indre ringkant
    private const double RMaanedstekst = 296; // månedsnavn utenfor ringen
    private const double RRingInner = 128;    // innerste årsring
    private const double RRingYtre = 262;     // ytterste årsring

    private static readonly string[] Maanedskort =
        ["Jan", "Feb", "Mar", "Apr", "Mai", "Jun", "Jul", "Aug", "Sep", "Okt", "Nov", "Des"];

    /// <summary>Bygger hele hjulets SVG-innhold som markup (SVG &lt;text&gt; kolliderer ellers med Razors tekstelement).</summary>
    private MarkupString ByggHjul(List<int> aar)
    {
        var sb = new StringBuilder();

        // Månedsskive: sektorlinjer + månedsnavn.
        for (var m = 1; m <= 12; m++)
        {
            var (lx1, ly1) = Punkt(RInnerste, GradForMaanedstart(m));
            var (lx2, ly2) = Punkt(RYtre, GradForMaanedstart(m));
            sb.Append($"<line x1=\"{F(lx1)}\" y1=\"{F(ly1)}\" x2=\"{F(lx2)}\" y2=\"{F(ly2)}\" class=\"hjul-sektor\" />");

            var (mx, my) = Punkt(RMaanedstekst, GradForDag(m, 15));
            sb.Append($"<text x=\"{F(mx)}\" y=\"{F(my)}\" class=\"hjul-maaned\" text-anchor=\"middle\" dominant-baseline=\"middle\">{Maanedskort[m - 1]}</text>");
        }

        sb.Append($"<circle cx=\"{F(Senter)}\" cy=\"{F(Senter)}\" r=\"{F(RYtre)}\" class=\"hjul-ramme\" />");
        sb.Append($"<circle cx=\"{F(Senter)}\" cy=\"{F(Senter)}\" r=\"{F(RInnerste)}\" class=\"hjul-ramme\" />");

        // Én ring per budsjettår.
        for (var i = 0; i < aar.Count; i++)
        {
            var r = RadiusForIndeks(i, aar.Count);
            sb.Append($"<circle cx=\"{F(Senter)}\" cy=\"{F(Senter)}\" r=\"{F(r)}\" fill=\"none\" stroke=\"{Visningformat.FargeForAar(aar[i])}\" stroke-opacity=\"0.28\" stroke-width=\"2\" />");
        }

        // Frist-punkter med native tooltip (<title>).
        foreach (var frist in Frister)
        {
            var r = RadiusForIndeks(aar.IndexOf(frist.Budsjettaar), aar.Count);
            var (px, py) = Punkt(r, GradForDato(frist.Sorteringsdag));
            var tooltip = System.Net.WebUtility.HtmlEncode(
                $"{Visningformat.FormatDato(frist)} – {frist.Tittel}{(frist.ErTentativ ? " (tentativ)" : "")}");
            sb.Append($"<circle cx=\"{F(px)}\" cy=\"{F(py)}\" r=\"7\" fill=\"{Visningformat.FargeForAar(frist.Budsjettaar)}\" stroke=\"#fff\" stroke-width=\"2\" class=\"hjul-punkt\"><title>{tooltip}</title></circle>");
        }

        sb.Append($"<text x=\"{F(Senter)}\" y=\"{F(Senter)}\" class=\"hjul-senter\" text-anchor=\"middle\" dominant-baseline=\"middle\">Årshjul</text>");

        return new MarkupString(sb.ToString());
    }

    /// <summary>Radius for budsjettår nr. <paramref name="i"/> av <paramref name="antall"/> (jevnt fordelt; midt ved ett år).</summary>
    private static double RadiusForIndeks(int i, int antall)
    {
        if (i < 0) i = 0;
        return antall <= 1 ? (RRingInner + RRingYtre) / 2 : RRingInner + (RRingYtre - RRingInner) * i / (antall - 1);
    }

    /// <summary>Vinkel (grader) for en dato: Jan 1 øverst (kl. 12), med klokken gjennom året.</summary>
    private static double GradForDato(DateOnly d)
    {
        var start = new DateOnly(d.Year, 1, 1);
        var lengde = (new DateOnly(d.Year, 12, 31).DayNumber - start.DayNumber) + 1;
        var frac = (d.DayNumber - start.DayNumber) / (double)lengde;
        return frac * 360 - 90;
    }

    // Månedsskive-vinkler bruker et fast referanseår (ikke-skuddår) — kun avhengig av måned/dag.
    private static double GradForMaanedstart(int maaned) => GradForDato(new DateOnly(2027, maaned, 1));
    private static double GradForDag(int maaned, int dag) => GradForDato(new DateOnly(2027, maaned, dag));

    private static (double X, double Y) Punkt(double radius, double grader)
    {
        var rad = grader * Math.PI / 180.0;
        return (Senter + radius * Math.Cos(rad), Senter + radius * Math.Sin(rad));
    }

    /// <summary>Formaterer et koordinat med punktum-desimal (SVG krever invariant kultur).</summary>
    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    protected override Task<IReadOnlyList<FristDto>> HentAsync(ISynlighetskontekst ctx)
        => Lesing.HentSynligeAsync(ctx, Tilstand.TilFilter());
}
